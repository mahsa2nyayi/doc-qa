# Copy to .env for local (non-Docker) development and export the variables
# (the docker compose setup already defines its own).
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=docqa
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

CELERY_BROKER_URL=redis://localhost:6379/0
MEDIA_ROOT=./media

# Embeddings: "hash" (default, no download) or "sentence-transformers"
EMBEDDING_BACKEND=hash
# EMBEDDING_MODEL=intfloat/multilingual-e5-small

# Answers: "extractive" (default) or "anthropic" (needs ANTHROPIC_API_KEY)
ANSWER_BACKEND=extractive
# ANTHROPIC_API_KEY=
# ANSWER_MODEL=claude-sonnet-5-5

# Tuning
# CHUNK_MAX_CHARS=400
# CHUNK_OVERLAP_CHARS=80
# RETRIEVAL_MIN_SCORE=0.05
# MAX_UPLOAD_MB=10
